generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Cliente {
  id           String        @id @default(uuid())
  nombre       String
  email        String?
  telefono     String?
  nif          String?
  createdAt    DateTime      @default(now())
  proyectos    Proyecto[]
  presupuestos Presupuesto[]
}

model Proveedor {
  id        String   @id @default(uuid())
  nombre    String
  email     String?
  telefono  String?
  nif       String?
  createdAt DateTime @default(now())
}

model Producto {
  id        String   @id @default(uuid())
  nombre    String
  precio    Decimal
  tipo      String
  createdAt DateTime @default(now())
}

model Proyecto {
  id        String   @id @default(uuid())
  nombre    String
  estado    String   @default("activo")
  clienteId String
  cliente   Cliente  @relation(fields: [clienteId], references: [id])
  tareas    Tarea[]
  createdAt DateTime @default(now())
}

model Tarea {
  id         String   @id @default(uuid())
  titulo     String
  estado     String   @default("pendiente")
  proyectoId String
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id])
  createdAt  DateTime @default(now())
}

model Presupuesto {
  id        String   @id @default(uuid())
  numero    String
  estado    String   @default("borrador")
  total     Decimal
  clienteId String
  cliente   Cliente  @relation(fields: [clienteId], references: [id])
  createdAt DateTime @default(now())
}
